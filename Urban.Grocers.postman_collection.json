    {
      "name": "Criar um kit vazio",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "// 1. Validar se o servidor criou o recurso (código 201 = Criado)\r",
              "pm.test(\"Status code é 201 (Criado com sucesso)\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "// 2. Validar se a resposta trouxe um ID (prova que foi salvo no banco)\r",
              "pm.test(\"A resposta contém um 'id'\", function () {\r",
              "    pm.response.to.have.jsonBody('id');\r",
              "});\r",
              "// 3. Validar se o nome do kit que foi criado é o que eu mandei\r",
              "pm.test(\"O nome do kit criado está correto\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.name).to.eql(\"Into space\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
