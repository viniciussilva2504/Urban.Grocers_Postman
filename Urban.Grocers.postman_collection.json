              "});\r",
              "// 2. Validar se a resposta é uma lista\r",
              "pm.test(\"A resposta é uma lista de produtos\", function () {\r",
              "    pm.expect(pm.response.json()).to.be.an('array');\r",
              "});\r",
              "// 3. Validar se a lista NÃO está vazia (tem produtos dentro)\r",
              "pm.test(\"A lista de produtos não está vazia\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.length).to.be.above(0);\r",
              "});"
