  "item": [
    {
      "name": "Obter uma lista de kits no cartão",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "// 1. Validar se a URL respondeu com sucesso (código 200)\r",
              "pm.test(\"Status code é 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Validar se a resposta veio em formato de lista (array)\r",
              "pm.test(\"A resposta é uma lista de kits\", function () {\r",
              "    pm.expect(pm.response.json()).to.be.an('array');\r",
              "});\r",
              "\r",
              "// 3. Validar se o primeiro kit da lista tem um 'id'\r",
              "pm.test(\"O primeiro kit da lista tem um ID\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData[0]).to.have.property('id');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{server_url}}/api/v1/kits?cardId=1",
          "host": [
            "{{server_url}}"
          ],
          "path": [
            "api",
            "v1",
            "kits"
          ],
          "query": [
            {
              "key": "cardId",
              "value": "1"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Obter uma lista de produtos no kit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "// 1. Validar se a busca funcionou (código 200)\r",
              "pm.test(\"Status code é 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "// 2. Validar se o nome do kit retornado é realmente \"Into space\"\r",
              "pm.test(\"O nome do kit retornado é 'Into space'\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    // Pega o primeiro item da lista e verifica se o nome dele é Into space\r",
              "    pm.expect(jsonData[0].name).to.eql(\"Into space\");\r",
              "});"
            ],
